<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Orleans">
    <PackageVersion Include="Microsoft.Orleans.Runtime" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.AdoNet" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.AdoNet" Version="10.4.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.3" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
 
</Project>
