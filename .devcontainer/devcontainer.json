{
  "name": "gleis-grain",
  "image": "mcr.microsoft.com/devcontainers/base:noble@sha256:21e9e3275736cb3bc33a2904b279a2ab292c51fedd53c2963463627d4586c3e6",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2.5.0": {
      "version": "10.0.402"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "version": "29.9.2",
      "moby": false
    }
  },
  // docker-outside-of-docker publishes container ports on the host's 127.0.0.1 only.
  // The host network makes that the same localhost the AppHost and the services use.
  "runArgs": ["--network=host"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig",
        "github.vscode-github-actions"
      ],
      "settings": {
        "dotnet.defaultSolution": "gleis-grain.slnx",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      }
    }
  },
  "remoteEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true"
  },
  "postCreateCommand": "dotnet restore gleis-grain.slnx"
}
